# Add these in Vercel > Settings > Environment Variables (Production), then Redeploy.
# For local testing with `npx vercel dev`, copy this file to .env and fill it in.

# Web3Forms access key (web3forms.com > create a form for alikacars.baguio@gmail.com)
VITE_WEB3FORMS_KEY=

# Password for the admin dashboard at /admin. Pick something long.
ADMIN_PASSWORD=

# Set automatically when you connect Upstash Redis in Vercel > Storage. No need to type these.
KV_REST_API_URL=
KV_REST_API_TOKEN=
