# Copy to .env for local testing, and add the same names in Vercel > Settings > Environment Variables.

# From web3forms.com (sent to alikacars.baguio@gmail.com when you sign up)
VITE_WEB3FORMS_KEY=

# From semaphore.co > Account > API
SEMAPHORE_API_KEY=
# Optional: your approved sender name (leave empty to use Semaphore's default)
SEMAPHORE_SENDER_NAME=
# Optional: phone that receives booking texts (defaults to 09291805772)
ALIKA_SMS_TO=09291805772
